[Unit]
Description=FroodzOS: stage the laptop's own audio firmware and restart the audio DSP (only with fz_sound=1)
ConditionKernelCommandLine=fz_sound=1
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fz-sound-setup --wait 45
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
