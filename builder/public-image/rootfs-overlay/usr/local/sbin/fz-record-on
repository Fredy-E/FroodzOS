#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# fz-record-on: the single "record everything" switch for the FroodzOS live test system.
#
#   fz-record-on            exit 0 only when the kernel command line has the whole word fz_record=full
#   fz-record-on --print    print the active profile: full or off (always exits 0)
#   fz-record-on --excess   exit 0 only when fz_record=full AND fz_excess=1 are both on the command line
#                           (the "excessive logs" level: console at loglevel 8, journald forwarded to kmsg)
#   fz-record-on --help
#
# Other tools (terminal recorder, UI/Android capture, journald setup, the sleep hook) call this
# instead of parsing /proc/cmdline themselves. The switch is off unless the owner explicitly adds
# fz_record=full to a GRUB entry, so the public image keeps its normal behaviour.
# FZ_CMDLINE overrides /proc/cmdline (unit tests and other harnesses).
set -u

if [ "${FZ_CMDLINE+set}" = set ]; then
    CMDLINE=$FZ_CMDLINE
else
    CMDLINE=$(cat /proc/cmdline 2>/dev/null || true)
fi

PROFILE=off
EXCESS=0
set -f
for word in $CMDLINE; do
    [ "$word" = "fz_record=full" ] && PROFILE=full
    [ "$word" = "fz_excess=1" ] && EXCESS=1
done
set +f

case "${1:-}" in
    --print|-p)
        echo "$PROFILE"
        exit 0
        ;;
    --help|-h)
        sed -n '2,13p' "$0"
        exit 0
        ;;
    --excess)
        [ "$PROFILE" = full ] && [ "$EXCESS" = 1 ]
        exit $?
        ;;
    "")
        [ "$PROFILE" = full ]
        exit $?
        ;;
    *)
        echo "usage: fz-record-on [--print|--excess]" >&2
        exit 2
        ;;
esac
