#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""fz-smartlog v3 entry point.

Usage:
  fz-smartlog run       continuous recorder (the systemd service)
  fz-smartlog once      one snapshot to stdout
  fz-smartlog report    print the newest summary.txt of this boot
  fz-smartlog snapshot  run one snapshot (used by the supervisor and tests)
  fz-smartlog status    print the destination/marker/privacy decision as JSON
  fz-smartlog prune     prune old boot folders under the current destination
"""
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
_LIB = os.path.normpath(os.path.join(_HERE, "..", "lib", "fz-smartlog"))
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from fz_smartlog.__main__ import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
