#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""fz-smartlog-write <stream> - append JSON lines from stdin to a smartlog stream.

This is the shell-facing plug-in contract: it honours FZ_LOG_DIR,
FZ_LOG_SEGMENT_BYTES, FZ_LOG_SYNC_MS, FZ_LOG_SYNC_BYTES,
FZ_LOG_MAX_STREAM_BYTES[_<STREAM>], FZ_LOG_PRIVACY and FZ_LOG_SCHEMA.
Each input line must be a JSON object; non-object lines are wrapped in an
``_fz:"unparsed"`` record instead of being silently lost.
"""
import json
import os
import sys
import time

_HERE = os.path.dirname(os.path.abspath(__file__))
_LIB = os.path.normpath(os.path.join(_HERE, "..", "lib", "fz-smartlog"))
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

from fz_smartlog.writer import DestinationFailed, StreamWriter, utc_iso  # noqa: E402


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    if not args:
        print("usage: fz-smartlog-write <stream>", file=sys.stderr)
        return 2
    stream = args[0]
    base = os.environ.get("FZ_LOG_DIR")
    if not base:
        print("fz-smartlog-write: FZ_LOG_DIR is not set", file=sys.stderr)
        return 2
    cap_name = "FZ_LOG_MAX_STREAM_BYTES_%s" % stream.upper()
    cap = int(os.environ.get(cap_name, os.environ.get("FZ_LOG_MAX_STREAM_BYTES", 32 << 20)))
    writer = StreamWriter(
        stream, base_dir=base, max_bytes=cap,
        segment_bytes=int(os.environ.get("FZ_LOG_SEGMENT_BYTES", 8 << 20)),
        sync_ms=int(os.environ.get("FZ_LOG_SYNC_MS", 1000)),
        sync_bytes=int(os.environ.get("FZ_LOG_SYNC_BYTES", 65536)),
        privacy=os.environ.get("FZ_LOG_PRIVACY", "owner"))
    try:
        for line in sys.stdin:
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except ValueError:
                record = {"_fz": "unparsed", "line": line[:4096]}
            if not isinstance(record, dict):
                record = {"_fz": "unparsed", "value": record}
            record.setdefault("ts", utc_iso())
            record.setdefault("mono", round(time.monotonic(), 6))
            writer.write(record)
    except KeyboardInterrupt:
        pass
    except DestinationFailed as exc:
        print("fz-smartlog-write: destination failed: %s" % exc, file=sys.stderr)
        return 1
    finally:
        try:
            writer.close("eof")
        except DestinationFailed:
            return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
