[Desktop Entry]
Type=Application
Name=Mount disk image
Comment=Attach a disk image read-only and open it
Exec=/usr/local/bin/fz-mount-image %f
Icon=drive-removable-media
Terminal=false
NoDisplay=false
Categories=System;Utility;
MimeType=application/x-raw-disk-image;application/x-iso9660-image;application/vnd.efi.img;application/vnd.efi.iso;application/x-cd-image;
