@@ -65,10 +65,16 @@
                 return log_error_status(err, "Cannot read sections: %m");
 
         /* Do we need to ensure under 4gb address on x86? */
+        /* The ARM64 kernel requires 64K (TEXT_OFFSET) load alignment, but AllocateAnyPages only
