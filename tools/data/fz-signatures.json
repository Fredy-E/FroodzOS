{
  "schema": 1,
  "description": "FroodzOS boot-log signature catalog. Regexes are generic and case-insensitive; they match a single normalised message after timestamp/priority prefixes are removed. No captured SSID, MAC, serial, username or e-mail value is embedded.",
  "source": "Productised from the W8 signature-catalog research (FroodzOS test stick, 2026-11-25).",
  "signatures": [
    {
      "id": "nvme-enable-oops",
      "regex": "^.*(Unable to handle kernel NULL pointer dereference|gpio_shared_add_proxy_lookup).*",
      "subsystem": "kernel",
      "severity": "critical",
      "class": "KNOWN-ISSUE",
      "issue": "nvme-enable-oops",
      "note": "NULL dereference during PCIe/NVMe enable; the documented dead end. Keep NVMe enable out of release images.",
      "priority": 110
    },
    {
      "id": "kernel-hard-fault",
      "regex": "^.*(kernel BUG at|general protection fault|Kernel panic|soft lockup|hung task|Unable to handle kernel).*",
      "subsystem": "kernel",
      "severity": "critical",
      "class": "KNOWN-ISSUE",
      "issue": "kernel-hard-fault",
      "note": "Hard kernel fault signature; collect the full context before blaming a driver.",
      "priority": 109
    },
    {
      "id": "mac80211-resume-warning",
      "regex": "^.*WARNING:.*net/mac80211/util\\.c.*",
      "subsystem": "wifi",
      "severity": "critical",
      "class": "KNOWN-ISSUE",
      "issue": "ath12k-resume-failure",
      "note": "mac80211 reconfig WARNING during resume; part of the confirmed Wi-Fi resume failure.",
      "priority": 108
    },
    {
      "id": "ath12k-resume-failure",
      "regex": "^.*ath12k.*(failed to resume|resume core|firmware crashed|WMI.*timeout).*",
      "subsystem": "wifi",
      "severity": "high",
      "class": "KNOWN-ISSUE",
      "issue": "ath12k-resume-failure",
      "note": "ath12k fails to resume after suspend; suspend was disabled in dev.9 because of this.",
      "priority": 107
    },
    {
      "id": "wifi-hardware-unavailable-resume",
      "regex": "^.*Hardware became unavailable upon resume.*",
      "subsystem": "wifi",
      "severity": "high",
      "class": "KNOWN-ISSUE",
      "issue": "ath12k-resume-failure",
      "note": "The PCIe device disappeared during resume; same family as the ath12k resume failure.",
      "priority": 106
    },
    {
      "id": "audio-topology-1001002",
      "regex": "^.*(DSP returned error\\s*\\[?1001002\\]?|Failed to start APM port).*",
      "subsystem": "sound",
      "severity": "high",
      "class": "KNOWN-ISSUE",
      "issue": "audio-topology-1001002",
      "note": "Yoga audio topology rejected by the DSP; the Romulus topology is required.",
      "priority": 105
    },
    {
      "id": "wsa884x-speaker-failure",
      "regex": "^.*(WSA Playback: ASoC error|DPN_PortCtrl register write failed|Program transport params failed).*",
      "subsystem": "sound",
      "severity": "high",
      "class": "KNOWN-ISSUE",
      "issue": "wsa884x-audio",
      "note": "WSA884x speaker-amplifier bring-up failure on several dspK roots.",
      "priority": 104
    },
    {
      "id": "soundwire-io-error",
      "regex": "^.*soundwire.*(IO error|read status failed|SCP|timeout).*",
      "subsystem": "sound",
      "severity": "high",
      "class": "KNOWN-ISSUE",
      "issue": "soundwire-io",
      "note": "SoundWire data-path error; often the cause of a missing speaker node.",
      "priority": 103
    },
    {
      "id": "audio-codec-warning",
      "regex": "^.*(snd|ASoC|wcd|WSA|lpass).*(WARN|error|failed).*",
