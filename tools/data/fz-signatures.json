      "severity": "medium",
      "class": "KNOWN-ISSUE",
      "issue": "audio-codec-warning",
      "note": "Codec/ASoC warning family; inspect the named component and error code.",
      "priority": 80
    },
    {
      "id": "pipewire-speaker-start",
      "regex": "^.*pipewire.*(failed to start|no sound|error).*",
      "subsystem": "sound",
      "severity": "medium",
      "class": "KNOWN-ISSUE",
      "issue": "pipewire-speaker-start",
      "note": "PipeWire could not start the speaker node; usually downstream of a SoundWire failure.",
      "priority": 79
    },
    {
      "id": "iio-sensor-proxy-failed",
      "regex": "^.*iio-sensor-proxy.*(Failed with result|sensor unavailable|SIGKILL|killed).*",
      "subsystem": "other",
      "severity": "medium",
      "class": "KNOWN-ISSUE",
      "issue": "iio-sensor-proxy-failed",
      "note": "Recurring failed unit caused by the stop timeout killing the service.",
      "priority": 78
    },
    {
      "id": "powerdevil-i2c-eacces",
      "regex": "^.*powerdevil.*(EACCES|Permission denied).*",
      "subsystem": "power",
      "severity": "medium",
      "class": "KNOWN-ISSUE",
      "issue": "powerdevil-i2c-eacces",
