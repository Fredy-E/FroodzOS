      "subsystem": "other",
      "severity": "low",
      "class": "KNOWN-ISSUE",
      "issue": "rtkit-missing",
      "note": "RealtimeKit is absent on older roots; audio clients then fall back.",
      "priority": 75
    },
    {
      "id": "keyring-wkd-failure",
      "regex": "^.*(WKD|keyserver).*(failed|error|timeout|refused).*",
      "subsystem": "other",
      "severity": "medium",
      "class": "KNOWN-ISSUE",
      "issue": "keyring-wkd-network",
