      "priority": 74
    },
    {
      "id": "kwin-software-rendering",
      "regex": "^.*kwin.*(software rendering|OpenGL|EGL|DRM).*(fail|error|fallback).*",
      "subsystem": "other",
      "severity": "medium",
      "class": "KNOWN-ISSUE",
      "issue": "kwin-software-rendering",
